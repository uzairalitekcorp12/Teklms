# Public website / displayed WhatsApp business number.
# This value is visible in the browser and does not authorize automatic sending.
NEXT_PUBLIC_WHATSAPP_NUMBER=923102218298
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi TekLMS, I want to know more about the learning platform.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Business Cloud API (server-only)
# Copy these from Meta for Developers > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Recommended for messages sent outside the 24-hour customer-service window.
# Create an approved template with one body variable for the TekLMS message text.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Server-only session signing secret
TEKLMS_SESSION_SECRET=wooBIdh0dvS4_zswg5lgOELpEMJnBN--QGFSSOE9S_4mnuh4GKGDGpuQO8hdIZhL

# Resend
# RESEND_API_KEY is the secret key copied from the Resend dashboard.
# onboarding@resend.dev is test-only and can send only to your Resend account email.
# Communication email testing is limited to Student 10 and this verified Resend account inbox.
RESEND_API_KEY=
RESEND_FROM="TekLMS <onboarding@resend.dev>"
# Student 10 communication mail is delivered to this Resend account inbox.
RESEND_STUDENT_10_RECIPIENT=m.uzair.tekcorp@gmail.com
# Signup and approval email testing can use this inbox until a verified sending domain is configured.
RESEND_TEST_RECIPIENT=m.uzair.tekcorp@gmail.com
# Replies go to the administrator; Gmail cannot be used as RESEND_FROM.
RESEND_REPLY_TO=m.uzair.tekcorp@gmail.com
# Receives new-registration review links after test mode is removed.
RESEND_ADMIN_RECIPIENT=m.uzair.tekcorp@gmail.com
