# Public website
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi TekLMS, I want to know more about the learning platform.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only session signing secret
TEKLMS_SESSION_SECRET=replace-with-a-long-random-secret

# Resend
# With onboarding@resend.dev and no verified domain, Resend can only send to the email
# attached to your Resend account.  therefore routes all outgoing test emails to
# RESEND_TEST_RECIPIENT while preserving each student's intended email in TekLMS.
RESEND_API_KEY=
RESEND_FROM=TekLMS <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=m.uzair.tekcorp@gmail.com
# Receives new-registration review links in direct-delivery/production mode.
RESEND_ADMIN_RECIPIENT=admin@example.com
